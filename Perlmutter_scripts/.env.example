# Perlmutter tunnel + shell configuration
# Copy this file to .env and fill in your values:
#   cp .env.example .env
# .env is gitignored and never committed.

# Your FNAL/Kerberos username (used for correlator4 and fasic-135413)
FNAL_USER=your_fnal_username

# Your NERSC username (used for perlmutter.nersc.gov)
NERSC_USER=your_nersc_username
